# Used by docker-compose.yml. Copy to .env and set real values (never commit .env).
# Generate each secret with:  openssl rand -hex 32
API_KEY=
SECRET_KEY=
POSTGRES_PASSWORD=

# First administrator, created on first start when no users exist. The password must be at
# least 10 characters and is changed at first login. Remove these lines after the first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Optional: AI-drafted outreach messages
GEMINI_API_KEY=

# Production only (docker-compose.prod.yml): the public hostname served over HTTPS
# DOMAIN=shai.example.com

# Change if these host ports are already in use (local stack only)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
