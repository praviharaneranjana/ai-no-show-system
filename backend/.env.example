DATABASE_URL=postgresql+psycopg://localhost/noshow_db

# Optional locally. If unset, the API logs a warning and runs unauthenticated.
# Required for any non-local deployment — set a long random value and send it
# as the X-API-Key header on every request except /, /health, /docs, /redoc,
# /openapi.json.
API_KEY=

# Optional: AI-drafted outreach messages (POST /outreach/draft). Falls back to templates if unset.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
