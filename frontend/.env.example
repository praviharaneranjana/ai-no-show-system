# Server-side only — never prefix these with NEXT_PUBLIC_, the frontend
# talks to the backend from Server Components/Actions, not the browser.
BACKEND_API_URL=http://localhost:8000

# Must match the backend's API_KEY. Leave empty for local dev if the
# backend also has no API_KEY set.
BACKEND_API_KEY=

# When running as the packaged desktop app (see electron/), leave both of
# the above unset. There's no .env in that build — the server address is
# entered once via the in-app /setup screen and stored under the OS user
# data directory instead. See lib/backend-config.ts.
